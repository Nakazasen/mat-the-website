# === Backend ENV Variables ===
# Copy file này thành .env và điền vào các giá trị

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mat-the-chapters

# Cloudflare R2 Public CDN base URL
# (Bật custom domain hoặc dùng public bucket URL)
R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev

# CORS - domain của frontend Vercel
ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:3000

# App settings
PORT=8000
