#!/usr/bin/env sh
set -eu

if command -v py >/dev/null 2>&1; then
  py -3 scripts/check_mojibake.py --staged
elif command -v python3 >/dev/null 2>&1; then
  python3 scripts/check_mojibake.py --staged
elif command -v python >/dev/null 2>&1; then
  python scripts/check_mojibake.py --staged
else
  echo "No Python runtime found for mojibake check." >&2
  exit 1
fi
