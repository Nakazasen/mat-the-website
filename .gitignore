# Gitignore - Mạt Thế Website

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build
.next/
out/
build/
dist/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/

# Environment variables (QUAN TRỌNG: đừng bao giờ commit file .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Content files (nội dung truyện không lên git, chỉ upload trực tiếp R2)
scripts/*.txt
scripts/*.json
scripts/mat-the-truyen/
**/*.docx
**/*.docx#
~$*.docx
